/* SPDX-License-Identifier: GPL-3.0-or-later
 * CRT-Kate Turbo Vision chrome — DOS/Borland TV 2.0 palette.
 * window blue #0000AA, gray bars #AAAAAA (black text, red hotkeys),
 * yellow #FFFF55, teal #00AAAA, green #00AA00, red hotkey #AA0000.
 * No bezel (CRT effects apply over all).
 */
QWidget {
    background-color: #0000AA;          /* TV window blue desktop */
    color: #FFFF55;
    font-family: "PxPlus IBM VGA8", "IBM Plex Mono", "DejaVu Sans Mono", monospace;
    font-size: 16px;
}
/* Menu bar: light-gray strip, black labels (hotkey drawn red by MenuBar). */
QMenuBar {
    background-color: #AAAAAA;
    color: #000000;
    /* Turbo Vision placement: indent the first title to ~column 2.
       padding-left ONLY -- Qt also applies a QSS *margin* to the vertical size
       hint (margin-left inflated the bar to 3 rows; regression test:
       menu_bar_is_one_flat_row). padding-left is vertical-clean. The ::item
       padding gives the ~4-space separation between titles (bisect probe:
       .relay/menurule.cpp cases A-G). */
    padding-left: 0.4em;
}
/* QMenuBar::item rules REMOVED: QStyleSheetStyle takes over item painting when
   these exist, which bypasses BorlandStyle::drawControl(CE_MenuBarItem) —
   the hotkey-red first letter can never be drawn there (probe: CECOUNT=0
   with the rules, then BorlandStyle paints). The item plate, glyph colors
   and title spacing now come from BorlandStyle (pixelMetric
   PM_MenuBarItemSpacing + the CE_MenuBarItem branch). */
/* Dropdown menus (TV-revision2 spec 6): solid light-gray box with NO
   line-drawing border. The PANEL is styled here; item painting (green
   full-width highlight, black text, red hotkey letter, check gutter,
   right-aligned shortcut, full-width separator) is done by
   BorlandStyle::drawControl(CE_MenuItem).
   NO QMenu::item / ::separator rules may exist: QStyleSheetStyle takes over
   item painting when they do, which bypasses BorlandStyle exactly like the
   QMenuBar::item case above (probe-verified for the menu bar). */
/* NOTE: NO QMenu rules AT ALL. QStyleSheetStyle intercepts CE_MenuItem
   painting as soon as the menu carries stylesheet rules (probe: the style's
   CE_MenuItem branch is never entered - 0 calls), which would make the green
   highlight / red hotkey letters / full-width separator impossible.
   The flat gray panel + no border come from BorlandStyle::drawPrimitive
   (PE_PanelMenu) instead. */
/* Status line: light-gray strip, black labels (red F-keys drawn by FKeyStatusBar). */
QStatusBar {
    background-color: #AAAAAA;
    color: #000000;
}
/* Editor / central placeholder = TV window-blue field. */
QPlainTextEdit, QTextEdit, QWidget#editorHost {
    background-color: #0000AA;
    color: #FFFF55;
    border: 1px solid #AAAAAA;
}
/* TV teal scrollbars: track + arrow/thumb blocks. */
QScrollBar:vertical {
    background: #00AAAA;
    width: 14px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #00AA00;
    min-height: 24px;
    border: 1px solid #000000;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: #00AAAA;
    height: 14px;
    border: 1px solid #000000;
}
QScrollBar::add-line:vertical:hover, QScrollBar::sub-line:vertical:hover {
    background: #00AA00;
}
QScrollBar:horizontal {
    background: #00AAAA;
    height: 14px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #00AA00;
    min-width: 24px;
    border: 1px solid #000000;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: #00AAAA;
    width: 14px;
    border: 1px solid #000000;
}
QScrollBar::add-line:horizontal:hover, QScrollBar::sub-line:horizontal:hover {
    background: #00AA00;
}
/* Turbo Vision modal dialogs (Settings/About/recovery): gray panel, white
 * double-line frame (approximated as a 2px white border), black text.
 * The offset drop shadow is added by the dialog paint overlay (QSS can't do
 * a translated shadow). */
QDialog, QMessageBox, QInputDialog {
    background-color: #AAAAAA;
    color: #000000;
    border: 2px solid #FFFFFF;
}
QDialog QLabel, QMessageBox QLabel, QInputDialog QLabel {
    background: transparent;
    color: #000000;
}
/* Editor placeholder glyph text: yellow like editor text (spec 4). Also
   never black — spec 1 bans pure black inside the window. */
QLabel#editorPlaceholder { background: transparent; color: #FFFF55; }
/* Document title in the top border row: WHITE, the same ink as the ═ it
   interrupts, on the window blue (never black). */
QLabel#editorTitle { background: transparent; color: #FFFFFF; }
/* The band that reserves the top border row paints NOTHING: EditorHost draws
   the ╔ ═ ╗ there, and an opaque band would erase it (the global QWidget rule
   above gives every widget a #0000AA background). */
QWidget#editorTitleRow { background: transparent; }
/* TV push buttons: green field, white/black label (raised bevel via style). */
QPushButton {
    background-color: #00AA00;
    color: #FFFFFF;
    border: 1px solid #000000;
    padding: 3px 14px;
    min-width: 60px;
}
QPushButton:hover { background-color: #1FBE1F; }
QPushButton:pressed { background-color: #148A14; }
/* Dialog input fields: TV blue field, white text, yellow selection. */
QLineEdit, QSpinBox, QComboBox {
    background-color: #0000AA;
    color: #FFFFFF;
    border: 1px solid #000000;
    selection-background-color: #FFFF55;
    selection-color: #0000AA;
}
